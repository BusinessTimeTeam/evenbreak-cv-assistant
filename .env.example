# Local development configuration for the chat UI (docker compose).
# Copy this file to .env and fill in MODEL_ACCESS_KEY. See the README
# "Local development with Docker" section for how to create one.

# DigitalOcean model access key for serverless inference. Used to embed the
# knowledge base when the image is built, and for every chat turn at runtime.
MODEL_ACCESS_KEY=

# --- Only used by evals/compare.py, to call the OLD managed agent for the
# side-by-side comparison. Not used by the chat UI.
# The remote managed agent's OpenAI-compatible chat endpoint (run
# `terraform output agent_endpoint` from deploy/ if the agent is recreated).
AGENT_ENDPOINT=https://npqf2dhsif66dkb2fjtorw2u.agents.do-ai.run/api/v1/chat/completions

# An API key you mint once for the agent and reuse across restarts.
AGENT_API_KEY=
