# Secrets for Terraform, supplied as environment variables rather than committed
# config. Copy to env.sh (gitignored) and fill in real values, then:
#
#   source env.sh
#   terraform plan
#
# Terraform automatically maps TF_VAR_<name> to the variable <name>.

# DigitalOcean API token (var.do_token).
export TF_VAR_do_token="dop_v1_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Model access key the chat UI uses for serverless inference (var.model_access_key).
# Create one in the DO console (Inference > Model Access Keys) scoped to
# gpt-oss-20b and Qwen3 Embedding 0.6B.
# It must match the MODEL_ACCESS_KEY GitHub secret exactly: the key is part of
# the droplet's user_data, so a different value here and in CI makes every
# apply replace the droplet.
export TF_VAR_model_access_key="sk-do-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# The s3 state backend authenticates via these standard AWS env vars, set to a
# DigitalOcean Spaces access key for the evenbreak-cv-assistant-tfstate bucket.
export AWS_ACCESS_KEY_ID="DOxxxxxxxxxxxxxxxxxxxx"
export AWS_SECRET_ACCESS_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
